FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/ZeroTeamsMcp.Core/ src/ZeroTeamsMcp.Core/
COPY src/ZeroTeamsMcp.ControlPlane/ src/ZeroTeamsMcp.ControlPlane/
RUN dotnet restore src/ZeroTeamsMcp.ControlPlane/ZeroTeamsMcp.ControlPlane.csproj
RUN dotnet publish src/ZeroTeamsMcp.ControlPlane/ZeroTeamsMcp.ControlPlane.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# curl para el healthcheck de docker-compose
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Security: non-root user
RUN groupadd -r appgroup && useradd -r -g appgroup appuser
USER appuser

COPY --from=build /app/publish .
EXPOSE 5100

# Security headers via middleware (configured in Program.cs)
ENTRYPOINT ["dotnet", "ZeroTeamsMcp.ControlPlane.dll"]