FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/ZeroTeamsMcp.Core/ src/ZeroTeamsMcp.Core/
COPY src/ZeroTeamsMcp.Server/ src/ZeroTeamsMcp.Server/
RUN dotnet restore src/ZeroTeamsMcp.Server/ZeroTeamsMcp.Server.csproj
RUN dotnet publish src/ZeroTeamsMcp.Server/ZeroTeamsMcp.Server.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "ZeroTeamsMcp.Server.dll"]
