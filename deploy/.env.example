AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Clave de cifrado (mín 32 chars). Genera con: openssl rand -base64 32
ENCRYPTION_KEY=

# Token admin del ControlPlane (para registrar clientes admin y admin_* tools)
ADMIN_TOKEN=

# URL pública del MCP server (la que reciben los clientes al registrarse).
# En prod: el dominio del tunnel de Cloudflare, ej. https://mcp.tudominio.com/mcp
MCP_SERVER_URL=http://localhost:5200/mcp

DATA_DIR=/data
TRANSPORT=stdio

# Dev mode (diagnósticos seguros, SIN relajar auth/guards/denylist)
# MCP_DEV_MODE=true  # Server: log Debug + responseChars (sin PII). ControlPlane: Swagger habilitado.

# Denylist de la key restricted (el proceso MCP :5200). La key admin no la lee.
# Si RESTRICTED_DENY_EMAILS está vacía, la key restricted no puede leer nada.
RESTRICTED_DENY_EMAILS=anas.chatt@optimaretail.es,julie.villegas@optimaretail.es,maruan.lharrak@optimaretail.es,sekuna.jawara@optimaretail.es,sergio.cabo@optimaretail.es,noe.francisco@optimaretail.es
RESTRICTED_DENY_TEAMS=IT (INMIGRANTES) IT
# GUID del equipo, opcional. Cubre un renombre. Separar por comas.
RESTRICTED_DENY_TEAM_IDS=
